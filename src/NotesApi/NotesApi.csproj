<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- /// açıklamalarını XML dosyasına çıkarır; OpenAPI bu dosyadan Swagger açıklamalarını üretir. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: "public üyede XML açıklaması yok" uyarısı. Her üyeye açıklama zorunlu değil. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

</Project>
